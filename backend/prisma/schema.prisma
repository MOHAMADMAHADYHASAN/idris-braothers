datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================================================
// ENUMS FOR FENI BAZAR GROCERY & SPICE POS
// ========================================================

enum SaleType {
  RETAIL    // খুচরা
  WHOLESALE // পাইকারি
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum PurchaseStatus {
  COMPLETED
  CANCELLED
}

enum CustomerLedgerType {
  SALE_DUE          // বাকিতে পণ্য ক্রয় -> কাস্টমারের দেনা বৃদ্ধি (Debit)
  PAYMENT_RECEIVED  // নগদ জমা/পরিশোধ -> কাস্টমারের দেনা হ্রাস (Credit)
  OPENING_BALANCE   // পূর্বের বকেয়া হিসাব শুরু
  ADJUSTMENT        // কোনো ছাড় বা হিসাব সমন্বয়
}

enum SupplierLedgerType {
  PURCHASE_DUE      // মহাজন থেকে বাকিতে পণ্য ক্রয় -> দোকানের দেনা বৃদ্ধি (Credit)
  PAYMENT_PAID      // মহাজনকে নগদ পরিশোধ -> দোকানের দেনা হ্রাস (Debit)
  OPENING_BALANCE   // মহাজনের পূর্বের পাওনা হিসাব শুরু
  ADJUSTMENT        // মহাজন থেকে ছাড় বা হিসাব সমন্বয়
}

enum ExpenseCategory {
  LABOR_KULI           // কুলি / লেবার খরচ
  TRANSPORT_VAN        // ভ্যান / ট্রাক ভাড়া
  ELECTRICITY_UTILITY  // বিদ্যুৎ বিল / দোকান ইউটিলিটি
  TEA_SNACKS           // চা-নাস্তা / মেহমানদারি
  SHOP_MAINTENANCE     // দোকান মেরামত / পলিথিন / বস্তা খরচ
  OTHER                // বিবিধ খরচ
}

// ========================================================
// 1. DYNAMIC UNIT MASTER (কাস্টমাইজেবল ইউনিট তালিকা)
// ========================================================

model UnitMaster {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. "কেজি", "গ্রাম", "প্যাকেট", "পিস", "বোতল", "লিটার", "হালি", "ডজন", "পাতা", "ফিতা", "বস্তা", "কার্টন", "পাল্লা", "টিন"
  banglaName  String?
  category    String?  // "WEIGHT", "VOLUME", "COUNT", "PACKAGING", "OTHER"
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

// ========================================================
// 2. CATEGORY & BRAND HIERARCHY (ক্যাটাগরি ও ব্র্যান্ড)
// ========================================================

model Category {
  id          String     @id @default(uuid())
  name        String     // e.g. "মসলা", "চাল ও ডাল", "তেল", "চিনি", "দুধ ও দুগ্ধজাত"
  banglaName  String?
  slug        String     @unique
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([name])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique // e.g. "Dano", "Fresh", "Teer", "ACI Pure", "Rupchanda"
  banglaName  String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
}

// ========================================================
// 3. PRODUCT & PRODUCT VARIANT (SKU) ARCHITECTURE
// ========================================================

model Product {
  id          String           @id @default(uuid())
  name        String           // e.g. "ডানো ফুল ক্রিম দুধ", "শুকনা মরিচ", "মিনিকেট চাল"
  banglaName  String?
  description String?
  
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  brandId     String?
  brand       Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  
  hasVariants Boolean          @default(false) // true হলে একাধিক সাইজ/গ্রেড আছে, false হলে একক সাধারণ পণ্য
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  variants    ProductVariant[]

  @@index([categoryId])
  @@index([brandId])
  @@index([name])
}

model ProductVariant {
  id                   String         @id @default(uuid())
  productId            String
  product              Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  variantName          String         // e.g. "৫০০ গ্রাম প্যাকেট", "১ কেজি প্যাকেট", "দেশি", "আমদানি (বোল্ড)" বা একক পণ্যে "Default"
  sku                  String         @unique // e.g. "DANO-500G", "CHILI-DESHI-01"
  barcode              String?        @unique
  
  // ডাইনামিক বেস ইউনিট (যেমন: "কেজি", "গ্রাম", "প্যাকেট", "লিটার", "পিস")
  baseUnitName         String         @default("কেজি")
  
  // ভগ্নাংশ/ওজন কন্ট্রোল ফ্ল্যাগ:
  // true = খোলা মরিচ/চাল (০.২৫০ কেজি বা ২০ টাকার এলাচ বিক্রি সম্ভব)
  // false = প্যাকেট দুধ/সাবান/তেলের বোতল (ক্যাশিয়ার ১, ২ এর জায়গায় ১.৫ বিক্রি করতে পারবে না)
  allowDecimalQty      Boolean        @default(true)
  
  // ফ্লেক্সিবল অ্যাট্রিবিউটস (JSONB) - যেমন: {"origin": "পঞ্চগড়", "grade": "A+", "netWeight": "500g"}
  attributes           Json?          @default("{}")
  
  // মূল স্টক (৪ দশমিকে নির্ভুল স্পাইস হিসাব)
  stockQuantity        Decimal        @default(0) @db.Decimal(12, 4)
  lowStockAlert        Decimal        @default(10) @db.Decimal(12, 4)
  
  // রিপ্লেসমেন্ট কস্ট ও বিক্রয়মূল্য (প্রতি baseUnit-এর জন্য)
  currentPurchasePrice Decimal        @db.Decimal(12, 2)
  retailPrice          Decimal        @db.Decimal(12, 2)
  wholesalePrice       Decimal        @db.Decimal(12, 2)
  
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  units                VariantUnit[]  // কার্টন / বস্তা কনভার্শন ফ্যাক্টর
  saleItems            SaleItem[]
  purchaseItems        PurchaseItem[]
  wastages             StockWastage[]

  @@index([productId])
  @@index([barcode])
  @@index([sku])
  @@index([variantName])
}

model VariantUnit {
  id               String         @id @default(uuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  unitName         String         // e.g. "৫০ কেজি বস্তা", "কার্টন (২৪ প্যাকেট)", "পাল্লা (৫ কেজি)"
  conversionFactor Decimal        @db.Decimal(12, 4) // মূল এককে রূপান্তর গুণক (e.g. 50.0000 for 50kg, 24.0000 for 24pkts)
  retailPrice      Decimal?       @db.Decimal(12, 2) // ঐ ইউনিটের জন্য সরাসরি খুচরা মূল্য (ঐচ্ছিক)
  wholesalePrice   Decimal?       @db.Decimal(12, 2) // ঐ ইউনিটের জন্য সরাসরি পাইকারি মূল্য (ঐচ্ছিক)
  barcode          String?        @unique
  isDefault        Boolean        @default(false)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([variantId, unitName])
  @@index([variantId])
}

model StockWastage {
  id                 String         @id @default(uuid())
  variantId          String
  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  quantity           Decimal        @db.Decimal(12, 4) // Base unit-এ নষ্ট বা ঘাটতির পরিমাণ (e.g. 2.5000 KG)
  costPriceSnapshot  Decimal        @db.Decimal(12, 2) // অপচয়ের সময়কার ক্রয়মূল্য
  lossAmount         Decimal        @db.Decimal(12, 2) // quantity * costPriceSnapshot
  reason             String         // e.g. "শুকিয়ে ওজন হ্রাস", "প্যাকেট নষ্ট", "ইঁদুরে খাওয়া/পড়ে যাওয়া"
  note               String?
  recordedAt         DateTime       @default(now())

  @@index([variantId])
  @@index([recordedAt])
}

// ========================================================
// 4. CUSTOMER KHATA / LEDGER (কাস্টমারের বাকির খাতা)
// ========================================================

model Customer {
  id           String           @id @default(uuid())
  name         String           // e.g. "হাজী রফিকুল ইসলাম"
  phone        String?          @unique
  address      String?          // e.g. "কাচারী রোড, ফেনী"
  customerType SaleType         @default(RETAIL) // RETAIL বা WHOLESALE
  
  // Running Balance: ধনাত্মক মান = কাস্টমারের কাছে পাওনা (Due), ঋণাত্মক মান = অগ্রিম জমা (Advance)
  currentDue   Decimal          @default(0) @db.Decimal(12, 2)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  sales        Sale[]
  ledger       CustomerLedger[]

  @@index([name])
  @@index([phone])
}

model CustomerLedger {
  id           String             @id @default(uuid())
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  saleId       String?
  sale         Sale?              @relation(fields: [saleId], references: [id], onDelete: SetNull)
  
  entryType    CustomerLedgerType
  debit        Decimal            @default(0) @db.Decimal(12, 2) // কাস্টমারের বাকির পাওনা বৃদ্ধি (+)
  credit       Decimal            @default(0) @db.Decimal(12, 2) // কাস্টমার কর্তৃক নগদ পরিশোধ জমা (-)
  balanceAfter Decimal            @db.Decimal(12, 2)             // এই লেনদেনের পর মোট বর্তমান বকেয়া
  note         String?            // e.g. "বিক্রয় ইনভয়েস #INV-261108-001", "নগদ বকেয়া জমা"
  createdAt    DateTime           @default(now())

  @@index([customerId])
  @@index([createdAt])
}

// ========================================================
// 5. SALES & INVOICING (বিক্রয় ও রসিদ)
// ========================================================

model Sale {
  id            String          @id @default(uuid())
  invoiceNumber String          @unique // e.g. "INV-261108-0001"
  saleType      SaleType        @default(RETAIL)
  
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  subTotal      Decimal         @db.Decimal(12, 2)
  discount      Decimal         @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal         @db.Decimal(12, 2) // subTotal - discount
  paidAmount    Decimal         @default(0) @db.Decimal(12, 2) // আজকের দেওয়া নগদ টাকা
  dueAmount     Decimal         @default(0) @db.Decimal(12, 2) // আজকের বিলে বকেয়া (grandTotal - paidAmount)

  status        SaleStatus      @default(COMPLETED)
  note          String?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  items         SaleItem[]
  ledgerEntries CustomerLedger[]

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id                String         @id @default(uuid())
  saleId            String
  sale              Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  unitName          String         // e.g. "৫০ কেজি বস্তা", "কেজি", "পাল্লা", "প্যাকেট"
  conversionFactor  Decimal        @default(1) @db.Decimal(12, 4)
  quantity          Decimal        @db.Decimal(12, 4) // বিক্রিত ইউনিটের সংখ্যা
  baseQuantity      Decimal        @db.Decimal(12, 4) // quantity * conversionFactor (স্টক থেকে বিয়োগ হবে)
  
  unitPrice         Decimal        @db.Decimal(12, 2) // বিক্রয়মূল্য প্রতি ইউনিট
  costPriceSnapshot Decimal        @db.Decimal(12, 2) // বিক্রির মুহূর্তের ক্রয়মূল্য (সঠিক মুনাফা হিসাবের জন্য)
  subTotal          Decimal        @db.Decimal(12, 2) // মোট টাকা (বা customTotalPrice)

  createdAt         DateTime       @default(now())

  @@index([saleId])
  @@index([variantId])
}

// ========================================================
// 6. SUPPLIER & PROCUREMENT (মহাজনের খাতা ও মাল ক্রয়)
// ========================================================

model Supplier {
  id             String           @id @default(uuid())
  name           String           // মহাজন বা বিক্রয় প্রতিনিধির নাম
  companyName    String?          // e.g. "খাতুনগঞ্জ আড়ত, চট্টগ্রাম", "মেসার্স সিটি ট্রেডার্স"
  phone          String?          @unique
  address        String?          // e.g. "খাতুনগঞ্জ, চট্টগ্রাম"
  
  // Running Balance: মহাজনের কাছে মোট দেনা (Payable)
  currentPayable Decimal          @default(0) @db.Decimal(12, 2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  purchases      Purchase[]
  ledger         SupplierLedger[]

  @@index([name])
  @@index([companyName])
  @@index([phone])
}

model SupplierLedger {
  id           String             @id @default(uuid())
  supplierId   String
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  purchaseId   String?
  purchase     Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  
  entryType    SupplierLedgerType
  debit        Decimal            @default(0) @db.Decimal(12, 2) // মহাজনকে নগদ পরিশোধ (-)
  credit       Decimal            @default(0) @db.Decimal(12, 2) // মহাজন থেকে বাকিতে মাল ক্রয় (+)
  balanceAfter Decimal            @db.Decimal(12, 2)             // এই লেনদেনের পর মোট বর্তমান দেনা
  note         String?            // e.g. "চালান #PUR-261108-0001", "মহাজনকে নগদ প্রদান"
  createdAt    DateTime           @default(now())

  @@index([supplierId])
  @@index([createdAt])
}

model Purchase {
  id             String         @id @default(uuid())
  purchaseNumber String         @unique // e.g. "PUR-261108-0001" বা মহাজনের চালান নম্বর
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])

  subTotal       Decimal        @db.Decimal(12, 2)
  transportCost  Decimal        @default(0) @db.Decimal(12, 2) // কুলি/ট্রাক/ভ্যান ভাড়া
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal        @db.Decimal(12, 2) // subTotal + transportCost - discount
  paidAmount     Decimal        @default(0) @db.Decimal(12, 2) // নগদে পরিশোধ
  dueAmount      Decimal        @default(0) @db.Decimal(12, 2) // বাকিতে রয়ে গেল (grandTotal - paidAmount)

  status         PurchaseStatus @default(COMPLETED)
  note           String?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          PurchaseItem[]
  ledgerEntries  SupplierLedger[]

  @@index([purchaseNumber])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id                String         @id @default(uuid())
  purchaseId        String
  purchase          Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])

  unitName          String         // e.g. "৫০ কেজি বস্তা", "কার্টন (২৪ প্যাকেট)", "কেজি"
  conversionFactor  Decimal        @default(1) @db.Decimal(12, 4)
  quantity          Decimal        @db.Decimal(12, 4) // ক্রয়ের ইউনিটের সংখ্যা
  baseQuantity      Decimal        @db.Decimal(12, 4) // quantity * conversionFactor (স্টকে যোগ হবে)
  
  unitCost          Decimal        @db.Decimal(12, 2) // ক্রয়মূল্য প্রতি ইউনিট
  newRetailPrice    Decimal?       @db.Decimal(12, 2) // নতুন খুচরা বিক্রয়মূল্য (ঐচ্ছিক, দিলে প্রডাক্টে আপডেট হবে)
  newWholesalePrice Decimal?       @db.Decimal(12, 2) // নতুন পাইকারি বিক্রয়মূল্য (ঐচ্ছিক, দিলে প্রডাক্টে আপডেট হবে)
  subTotal          Decimal        @db.Decimal(12, 2) // quantity * unitCost

  createdAt         DateTime       @default(now())

  @@index([purchaseId])
  @@index([variantId])
}

// ========================================================
// 7. DAILY PETTY EXPENSES (দোকানের দৈনিক খরচ)
// ========================================================

model DailyExpense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String          // e.g. "ট্রাক খালাসের কুলি বিল", "দোকানের চা-নাস্তা", "বিদ্যুৎ বিল"
  note        String?
  recordedAt  DateTime        @default(now())

  @@index([category])
  @@index([recordedAt])
}
